{
  "name": "bullet-hell-3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --config vite.config.desktop.js",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "generate-icon": "node scripts/generate-icon.mjs",
    "electron:dev": "npm run build:desktop && electron .",
    "dist:win": "npm run generate-icon && npm run build:desktop && electron-builder --win --x64",
    "dist:mac": "npm run generate-icon && npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --x64",
    "dist:desktop": "npm run generate-icon && npm run build:desktop && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.5",
    "three": "^0.184.0"
  },
  "build": {
    "appId": "com.ecaffrey.bullethell3d",
    "productName": "Bullet Hell 3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
